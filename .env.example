# Salin menjadi .env.local (JANGAN di-commit). Nilainya dari dashboard Supabase > Project Settings > API.

# --- Frontend (publik, aman dibaca browser) ---
VITE_SUPABASE_URL=https://xxxx.supabase.co
VITE_SUPABASE_ANON_KEY=isi-dengan-anon-atau-publishable-key

# --- Skrip di komputer lokal saja (RAHASIA, jangan ada di frontend, jangan di Vercel sebagai VITE_*) ---
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=isi-dengan-service-role-key
# Dipakai psql untuk menjalankan migrasi dan seed:
DATABASE_URL=postgresql://postgres:PASSWORD@db.xxxx.supabase.co:5432/postgres
